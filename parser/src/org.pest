sp      = _{ " " | "\t" }
newline = _{ "\r\n" | "\r" | "\n" }

active_time_quoted           =  { "<" ~ active_time_quoted_inner* ~ ">" }
active_time_quoted_inner     = _{
    literal_active_time_quoted
}
literal_active_time_quoted   = ${
    (!("<" | ">") ~ ANY | sp)+
}
inactive_time_quoted         =  { "[" ~ inactive_time_quoted_inner* ~ "]" }
inactive_time_quoted_inner   = _{
    literal_inactive_time_quoted
}
literal_inactive_time_quoted = ${
    (!("[" | "]") ~ ANY | sp)+
}

literal_link = ${
    (!("[" | "]") ~ ANY | sp)+
}

link_inner = _{
    literal_link
}

link_description = { "[" ~ link_inner* ~ "]" }
link             = { "[" ~ link_inner* ~ "]" }
hyperlink        = { "[" ~ link ~ link_description{0, 1} ~ "]" }

scheduled  = { ^"SCHEDULED:" ~ sp* ~ (active_time_quoted) }
deadline   = { ^"DEADLINE:" ~ sp* ~ (active_time_quoted) }
scheduling = { scheduled | deadline }

drawer_sep     = _{ ":" }
property_start = _{ drawer_sep ~ ^"PROPERTIES" ~ drawer_sep }
property_end   = _{ drawer_sep ~ ^"END" ~ drawer_sep }
property_key   =  { (!drawer_sep ~ ANY)+ }
property_k     = _{ drawer_sep ~ property_key ~ drawer_sep }
property_value =  {
    (active_time_quoted | inactive_time_quoted | (!newline ~ ANY))+
}
property       =  { property_k ~ sp* ~ property_value ~ sp* }
properties     =  { property_start ~ sp* ~ newline+ ~ (property ~ newline)* ~ property_end ~ sp* ~ newline* }

drawer_name     =  { ASCII_ALPHANUMERIC+ }
drawer_start    = _{ drawer_sep ~ drawer_name ~ drawer_sep }
drawer_end      = _{ drawer_sep ~ ^"END" ~ drawer_sep }
drawer_content  =  {
    (!(^":end:" | NEWLINE) ~ ANY)+
}
drawer_contents = ${
    (sp* ~ active_time_quoted ~ sp* | sp* ~ inactive_time_quoted ~ sp* | drawer_content)+
}
drawer          =  {
    (drawer_start ~ sp* ~ newline+) ~ (drawer_contents ~ newline+)* ~ (drawer_end ~ sp* ~ newline*)
}

keyword_start = _{ "#+" }
block_start   =  { keyword_start ~ ^"BEGIN" }
block_end     =  { keyword_start ~ ^"END" }

keyword_key   =  { (!(keyword_start | drawer_sep) ~ ANY)+ }
keyword_k     = _{ keyword_start ~ keyword_key ~ drawer_sep }
keyword_value =  { (!(newline) ~ ANY)* }
keyword       =  { keyword_k ~ sp* ~ keyword_value ~ sp* }

// Source code blocks: #+BEGIN_SRC lang ... #+END_SRC
src_block_begin_tag = _{ keyword_start ~ ^"BEGIN_SRC" }
src_block_end_tag   = _{ keyword_start ~ ^"END_SRC" }
src_block_lang      =  { (!newline ~ ANY)* }
src_block_body      =  { (!(newline ~ sp* ~ src_block_end_tag) ~ ANY)* }
src_block           =  {
    src_block_begin_tag ~ sp* ~ src_block_lang ~ newline ~
    src_block_body ~ newline ~
    sp* ~ src_block_end_tag ~ sp* ~ newline*
}

// Plain list items
list_bullet_unordered = { "-" | "+" }
list_bullet_ordered   = { ASCII_DIGIT+ ~ ("." | ")") }
list_bullet           = _{ list_bullet_unordered | list_bullet_ordered }

checkbox       = { "[" ~ checkbox_state ~ "]" }
checkbox_state = { "X" | " " | "-" }

list_item_text        = { (!newline ~ ANY)+ }
list_description_sep  = _{ " :: " }
list_description_term = { (!list_description_sep ~ !newline ~ ANY)+ }
list_description_body = { (!newline ~ ANY)+ }

list_item = {
    sp* ~ list_bullet ~ sp+ ~ checkbox? ~ sp* ~
    (list_description_term ~ list_description_sep ~ list_description_body | list_item_text)?
}

plain_list = { (list_item ~ newline)+ }

tags      =  { ":" ~ tag_inner+ ~ ":" }
tag_inner = _{ tag ~ (":" ~ tag)* }
tag       = ${
    (!(":") ~ ANY)+
}

// Priority cookie: [#A], [#B], [#C], etc.
priority = { "[#" ~ priority_value ~ "]" }
priority_value = { ASCII_ALPHA }

headline_symbol = { "*"+ }
todo_status     = { (^"TODO" | ^"DOING" | ^"DONE" | ^"NEXT" | ^"WAITING" | ^"CANCELLED" | ^"CANCELED" | ^"HOLD" | ^"SOMEDAY") }
headline_title  = { (!(tags | newline) ~ ANY)+ }
headline        = { sp* ~ headline_symbol ~ sp* ~ todo_status{0,1} ~ sp* ~ priority{0,1} ~ sp* ~ headline_title ~ sp* ~ tags* }

section_text = { !headline ~ (!NEWLINE ~ ANY)+ }
section_link = { !headline ~ (!NEWLINE ~ hyperlink) }

section_text_block = ${
    (section_link | section_text)+
}

section_content = _{
    (section_text_block ~ newline)
}

// NOTE: src_block MUST come before keyword to prevent #+BEGIN_SRC from
// being consumed as a generic keyword.
// NOTE: plain_list MUST come before section_content to prevent list items
// from being consumed as plain text.
section_meta = _{
    scheduling ~ newline*
  | properties ~ newline*
  | drawer ~ newline*
  | src_block ~ newline*
  | keyword ~ newline*
  | plain_list ~ newline*
}
section      =  {
    headline ~ newline+ ~ (section_meta | section_content)*
}

org = { properties* ~ newline* ~ drawer* ~ newline* ~ (keyword ~ newline)* ~ newline* ~ (section ~ newline*)* }
